# nginx SERVER block for the Unity WebGL build, dropped into
# /etc/nginx/templates/ so the official nginx image runs envsubst on it
# (substituting Railway's $PORT) and writes /etc/nginx/conf.d/default.conf.
#
# Web root = the contents of webgl/Build (index.html at /, engine payloads under
# /Build/, and the runtime asset tree under /StreamingAssets/assets/ that
# AssetSource fetches).

server {
    listen       ${PORT} default_server;
    listen       [::]:${PORT} default_server;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # On-the-fly gzip for text-ish payloads (binary .data/.wasm are already dense).
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/wasm image/svg+xml;
    gzip_min_length 1024;

    # Correct MIME for Unity WebGL artifacts.
    types {
        text/html                   html;
        text/css                    css;
        application/javascript      js;
        application/wasm            wasm;
        application/octet-stream    data;
        application/json            json;
        image/png                   png;
        audio/wav                   wav;
        image/webp                  webp;
        text/plain                  txt;
    }

    # Engine payloads (.wasm/.data/.framework.js) — hash-named, cache hard.
    location /Build/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The whole art/audio tree the AssetSource cache pulls at boot. Cache hard.
    location /StreamingAssets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
